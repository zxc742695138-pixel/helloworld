rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /posts/{postId} {
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.likedBy == []
        && request.resource.data.repostedBy == [];

      // Liking/reposting only ever toggles the caller's own uid in one of
      // these two arrays — text, author, and everything else stay frozen.
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy', 'repostedBy'])
        && request.resource.data.text == resource.data.text
        && request.resource.data.authorUid == resource.data.authorUid
        && request.resource.data.parentId == resource.data.parentId;

      allow delete: if false;
    }

    match /follows/{followId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.followerUid == request.auth.uid
        && followId == request.auth.uid + '_' + request.resource.data.handle;

      allow delete: if request.auth != null
        && resource.data.followerUid == request.auth.uid;

      allow update: if false;
    }

    match /notifications/{notifId} {
      allow read: if request.auth != null && resource.data.toUid == request.auth.uid;

      allow create: if request.auth != null
        && request.resource.data.fromUid == request.auth.uid;

      // The recipient may only flip `read` — nothing else on their own
      // notification, and never someone else's.
      allow update: if request.auth != null
        && resource.data.toUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);

      allow delete: if false;
    }

    match /conversations/{convId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.participants;

      // convId must be the two participants' uids sorted and joined — the
      // same deterministic scheme the client uses to find a thread without
      // a query — so nobody can create a doc under someone else's id.
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() == 2
        && convId == request.resource.data.participants[0] + '_' + request.resource.data.participants[1];

      // Only lastMessage/updatedAt/typing may change after creation.
      allow update: if request.auth != null
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.participantInfo == resource.data.participantInfo;

      allow delete: if false;

      match /messages/{messageId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participants;

        allow create: if request.auth != null
          && request.resource.data.senderUid == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participants;

        allow update: if false;
        allow delete: if false;
      }
    }
  }
}
