rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /posts/{postId} {
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.likedBy == []
        && request.resource.data.repostedBy == [];

      // Liking/reposting only ever toggles the caller's own uid in one of
      // these two arrays — text, author, and everything else stay frozen.
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy', 'repostedBy'])
        && request.resource.data.text == resource.data.text
        && request.resource.data.authorUid == resource.data.authorUid
        && request.resource.data.parentId == resource.data.parentId;

      allow delete: if false;
    }

    match /follows/{followId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.followerUid == request.auth.uid
        && followId == request.auth.uid + '_' + request.resource.data.handle;

      allow delete: if request.auth != null
        && resource.data.followerUid == request.auth.uid;

      allow update: if false;
    }

    match /notifications/{notifId} {
      allow read: if request.auth != null && resource.data.toUid == request.auth.uid;

      allow create: if request.auth != null
        && request.resource.data.fromUid == request.auth.uid;

      // The recipient may only flip `read` — nothing else on their own
      // notification, and never someone else's.
      allow update: if request.auth != null
        && resource.data.toUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);

      allow delete: if false;
    }
  }
}
